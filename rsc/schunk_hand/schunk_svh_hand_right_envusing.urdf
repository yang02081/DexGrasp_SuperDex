<?xml version="1.0" encoding="utf-8"?>
<!-- palm：
  z_rotation -> [link]right_hand_base_link  -> [joint fixed]right_hand_f4 -> [link]right_hand_e1-> 1
                                                                                                -> 2
                                                                                                -> 3
                                                                                                -> 4
  2  -> [joint] right_hand_j5 (mimic right_hand_Thumb_Opposition，为了实现对掌，可以看做它在ring和pinky都出现) -> [link]right_hand_e2   -> 2-1
                                                                                          -> 2-2
thumb:
  1 [joint] right_hand_Thumb_Opposition->[link]right_hand_z->[joint]right_hand_Thumb_Flexion->[link]right_hand_a->[joint]right_hand_j3->[link]right_hand_b->[joint]right_hand_j4->[link]right_hand_c->[joint fixed]thtip_joint->[link]thtip
ring:
  2-1 [joint]right_hand_ring_spread -> [link]right_hand_virtual_j -> [joint]right_hand_Ring_Finger->[link]right_hand_j->[joint]right_hand_j12->[link]right_hand_n->[joint]right_hand_j16->[link]right_hand_r->[joint fixed]rftip_joint->[link]rftip
pinky:
  2-2  [joint]right_hand_Finger_Spread -> [link]right_hand_virtual_i -> [joint]right_hand_Pinky-> [link]right_hand_i -> [joint]right_hand_j13 ->[link]right_hand_m -> [joint]right_hand_j17 -> [link]right_hand_q -> [joint]lftip_joint ->[link]lftip
index:
  3 [joint]right_hand_index_spread->[link]right_hand_virtual_l -> [joint]right_hand_Index_Finger_Proximal -> [link]right_hand_l ->[joint]right_hand_Index_Finger_Distal -> [link]right_hand_p -> [joint]right_hand_j14 -> [link]right_hand_t -> [joint]fftip_joint -> [link]fftip
middle:
  4 [joint fixed]right_hand_middle_spread_dummy->[link]right_hand_virtual_k->[joint]right_hand_Middle_Finger_Proximal -> [link]right_hand_k -> [joint]right_hand_Middle_Finger_Distal -> [link]right_hand_o -> [joint]right_hand_j15 -> [link]right_hand_s -> [joint]mftip_joint -> [link]mftip
-->
<robot name="svh">
  <link name="world"/>
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="allegro_root0"/>
  </joint>

  <link name="allegro_root0"><inertial><mass value="0.0"/><inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/></inertial></link>
  <link name="allegro_root1"><inertial><mass value="0.0"/><inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/></inertial></link>
  <link name="allegro_root2"><inertial><mass value="0.0"/><inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/></inertial></link>
  <link name="allegro_root3"><inertial><mass value="0.0"/><inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/></inertial></link>
  <link name="allegro_root4"><inertial><mass value="0.0"/><inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/></inertial></link>
  <link name="allegro_root5"><inertial><mass value="0.0"/><inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/></inertial></link>

  <joint name="x_joint" type="prismatic">
    <axis xyz="1 0 0"/>
    <limit lower="-0.5" upper="0.5" velocity="1.3"/>
    <parent link="allegro_root0"/>
    <child link="allegro_root1"/>
    <dynamics damping="10.0" friction="0.0001"/>
  </joint>
  <joint name="y_joint" type="prismatic">
    <axis xyz="0 1 0"/>
    <limit lower="-0.5" upper="0.5" velocity="1.3"/>
    <parent link="allegro_root1"/>
    <child link="allegro_root2"/>
    <dynamics damping="10.0" friction="0.0001"/>
  </joint>
  <joint name="z_joint" type="prismatic">
    <axis xyz="0 0 1"/>
    <limit lower="-0.5" upper="0.5" velocity="1.3"/>
    <parent link="allegro_root2"/>
    <child link="allegro_root3"/>
    <dynamics damping="10.0" friction="0.0001"/>
  </joint>
  <joint name="x_rotation_joint" type="revolute">
    <axis xyz="1 0 0"/>
    <limit lower="-3.14" upper="3.14" velocity="1.3"/>
    <parent link="allegro_root3"/>
    <child link="allegro_root4"/>
    <dynamics damping="10.0" friction="0.0001"/>
  </joint>
  <joint name="y_rotation_joint" type="revolute">
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" velocity="1.3"/>
    <parent link="allegro_root4"/>
    <child link="allegro_root5"/>
