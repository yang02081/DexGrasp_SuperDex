  </joint>
  <joint name="z_rotation_joint" type="revolute">
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" velocity="1.3"/>
    <parent link="allegro_root5"/>
    <child link="right_hand_base_link"/>
    <dynamics damping="10.0" friction="0.0001"/>
  </joint>

